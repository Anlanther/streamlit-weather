# Hong Kong Weather Dashboard — example environment file.
# Copy to `.env` and adjust as needed:  cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
#
# Values here are only used for variables the environment does not already set,
# so `export`, CI, and container config always take precedence.

# --- Local LLM (LM Studio) --------------------------------------------------
# API root of LM Studio's OpenAI-compatible server.
# Default: http://localhost:1234/v1
# In the dev container the app reaches the host via host.docker.internal.
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Model id to request. Leave unset to auto-detect the first loaded model.
# LM_STUDIO_MODEL=lmstudio-community/qwen2.5-7b-instruct

# Key sent to LM Studio. LM Studio accepts any non-empty value; set this only
# if you front it with a server that validates keys. Keep it out of VCS.
LM_STUDIO_API_KEY=lm-studio
